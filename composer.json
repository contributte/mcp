{
  "name": "contributte/mcp",
  "description": "Model Context Protocol (MCP) server integration for Nette Framework",
  "keywords": [
    "nette",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "server"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/contributte/mcp",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.4",
    "guzzlehttp/guzzle": "^7.10.0",
    "mcp/sdk": "^0.8.1",
    "nette/di": "^3.2.5",
    "psr/cache": "^3.0.0",
    "psr/container": "^2.0.2",
    "psr/simple-cache": "^3.0.0",
    "symfony/finder": "^7.4 || ^8.0"
  },
  "require-dev": {
    "ext-pdo": "*",
    "contributte/phpstan": "^0.2.0",
    "contributte/qa": "^0.5.0",
    "contributte/tester": "^0.5.0",
    "mockery/mockery": "^1.6.12",
    "nette/application": "^3.2.8",
    "nette/http": "^3.3.3",
    "symfony/console": "^7.4.1 || ^8.0.1",
    "tracy/tracy": "^2.11.0"
  },
  "suggest": {
    "nette/application": "Required for McpPresenter and McpRouter (HTTP transport)",
    "nette/http": "Required for McpPresenter and GuzzleBridge (HTTP transport)",
    "symfony/console": "Required for McpCommand (stdio transport)",
    "tracy/tracy": "Required for the Tracy debug panel"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Mcp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "conflict": {
    "nette/neon": "<3.4.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.3.x-dev"
    }
  }
}
